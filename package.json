{
  "name": "autonomous-api-optimizer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "backtest": "tsx --env-file=.env scripts/backtest.ts",
    "rl:train": "tsx --env-file=.env scripts/train-policy.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "services:up": "docker compose up -d mysql redis",
    "services:status": "docker compose ps mysql redis",
    "services:stop": "docker compose stop mysql redis",
    "demo:backtest": "tsx scripts/demo-backtest.ts",
    "test:e2e": "playwright test",
    "test:storage": "tsx scripts/test-storage.ts",
    "demo": "tsx scripts/demo-start.ts",
    "controller": "tsx --env-file=.env scripts/controller.ts",
    "aws:check": "tsx --env-file=.env scripts/aws-check.ts",
    "load:spike": "k6 run aws/load/spike.js",
    "load:sustain": "k6 run aws/load/sustain.js",
    "load:calm": "k6 run aws/load/calm.js"
  },
  "dependencies": {
    "@aws-sdk/client-auto-scaling": "^3.1102.0",
    "@aws-sdk/client-cloudwatch": "^3.1102.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1102.0",
    "@aws-sdk/client-ssm": "^3.1155.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "next": "^16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "prisma": "^6.19.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
