# --- Database ---
DATABASE_URL="mysql://optimizer:optimizer_password@127.0.0.1:3306/api_optimizer"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- App ---
NODE_ENV="development"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="generate-a-long-random-string-at-least-32-characters"

# --- RL Agent defaults ---
# RL_EPSILON_MIN raised from 0.05 to 0.15 after hyperparameter tuning: a higher
# exploration floor covers rare high-load states better and lowered held-out P95
# latency, SLA violations, and cost together. See outputs/tuning-report.md.
RL_EPSILON_START="1.0"
RL_EPSILON_MIN="0.15"
RL_EPSILON_DECAY="0.995"
RL_LEARNING_RATE="0.18"
RL_DISCOUNT_FACTOR="0.90"
RL_REWARD_WEIGHT_LATENCY="0.4"
RL_REWARD_WEIGHT_SLA="0.3"
RL_REWARD_WEIGHT_THROUGHPUT="0.2"
RL_REWARD_WEIGHT_COST="0.1"
RL_COST_REFERENCE_PER_THOUSAND_USD="0.00004"
SLA_TARGET_LATENCY_MS="200"
MIN_INSTANCES="2"
MAX_INSTANCES="12"

# --- Infra toggle ---
USE_REAL_AWS="false"
# Live-controller tick interval in ms (real AWS mode). Scrapes the gateway /fleet.
REAL_TICK_MS="5000"

# --- AWS (only required if USE_REAL_AWS=true) ---
# All ARNs/names/DNS below are printed by aws/infra/deploy.ps1 after the stack deploys.
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_AUTO_SCALING_GROUP_NAME=""
AWS_ALB_TARGET_GROUP_ARN=""
AWS_ALB_SECONDARY_TARGET_GROUP_ARN=""
AWS_ALB_LISTENER_RULE_ARN=""
AWS_CLOUDWATCH_NAMESPACE="PaymentGateway/Custom"
# Public ALB DNS (host only, no http://) the controller scrapes for live metrics.
AWS_ALB_DNS=""
# SSM parameter the cache-TTL action writes and gateway instances poll.
AWS_CACHE_TTL_PARAM="/optimizer/cacheTtlSec"
